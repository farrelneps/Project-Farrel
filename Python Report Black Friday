import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.read_csv("retail_black_friday_sales_100k.csv")

df.head(5)

df.info()

df.head(5)

df.isnull().sum()

df.duplicated().sum()

pd.pivot_table(
    data=df,
    index="age_group",
    columns=['gender','city'],
    values='quantity',
    aggfunc='sum'
)

consolidated_df = df.groupby("product_category")["quantity"].sum().sort_values(ascending=False).reset_index()

plt.figure(figsize=(10, 7))
sns.barplot(x='quantity', y='product_category', data=consolidated_df, palette='viridis')
plt.title('Kategori Produk Paling Banyak Terjual')
plt.xlabel('Jumlah Produk')
plt.ylabel('Kategori Produk')
plt.grid(axis='x', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.show()

df.groupby("product_category")["purchase_amount"].sum().sort_values(ascending=False)

df.corr(
numeric_only=True
) ["discount_pct"]\
.abs()\
.sort_values(ascending=False)

df.groupby("payment_method").agg(
    transaction_count=('transaction_amount', 'count'),
    fraud_rate=('fraud_flag', 'mean')
).sort_values(by=['transaction_count', 'fraud_rate'], ascending=[False, False])

penjualan_weekend = df.groupby("is_weekend")["purchase_amount"].sum().sort_values(ascending=False).reset_index()

plt.figure(figsize=(10, 7))
sns.barplot(x='is_weekend', y='purchase_amount', data=penjualan_weekend, palette='viridis')
plt.title('Apakah Weekend Penjualan Naik')
plt.xlabel('Weekend Atau Weekday')
plt.ylabel('Total Penjualan')
plt.grid(axis='x', linestyle='-')
plt.tight_layout()
plt.show()

df.groupby("is_weekend")["purchase_amount"].sum().sort_values(ascending=False)

df["purchase_hour"].value_counts().head(5)

df.groupby("is_black_friday")["purchase_amount"].sum().sort_values(ascending=False)
